// 27 MHz onboard oscillator
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// btn  = GO / commit (pin 87, proven). PULL_MODE=DOWN -> idle 0, pressed 1.
IO_LOC  "btn" 87;
IO_PORT "btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN SINGLE_RESISTOR=ON BANK_VCCIO=3.3;

// btn2 = SELECT / cycle slot (pin 88). Same DOWN pull -> idle 0, pressed 1.
IO_LOC  "btn2" 88;
IO_PORT "btn2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN SINGLE_RESISTOR=ON BANK_VCCIO=3.3;

// RECONFIG_N — dedicated pin 9, pulse low to reload from flash addr 0.
// MUST pack WITHOUT --reconfign_as_gpio or this pin stops triggering.
IO_LOC  "recfg_n" 9;
IO_PORT "recfg_n" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "cs" 60;
IO_PORT "cs" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "sclk" 59;
IO_PORT "sclk" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "mosi" 61;
IO_PORT "mosi" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "miso" 62;
IO_PORT "miso" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
