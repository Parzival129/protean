// soc rung 1: clock + 6 onboard LEDs
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;


// 4.3" 480x272 RGB LCD on the Tang Nano 20K onboard 40-pin connector.

// btn = NEXT / move selection (pin 88). DOWN pull -> idle 0, pressed 1.
IO_LOC  "btn" 88;
IO_PORT "btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN SINGLE_RESISTOR=ON BANK_VCCIO=3.3;

// btn2 = GO / commit the switch (pin 87). same DOWN pull.
IO_LOC  "btn2" 87;
IO_PORT "btn2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN SINGLE_RESISTOR=ON BANK_VCCIO=3.3;

// flash SPI (freed with --mspi_as_gpio) + reconfig trigger
IO_LOC  "cs" 60;
IO_PORT "cs" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "sclk" 59;
IO_PORT "sclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "mosi" 61;
IO_PORT "mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "miso" 62;
IO_PORT "miso" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "recfg_n" 9;
IO_PORT "recfg_n" IO_TYPE=LVCMOS33 DRIVE=8;

// CardKB I2C. Pins 71/72 are the genuinely-free GPIO (no onboard component).
// Earlier pins were secretly wired to onboard parts: 51=PA_EN (amp enable,
// pulled down -> killed SCL), 54=I2S_DIN, 79=2812_DIN, so I2C never worked.
IO_LOC  "scl" 71;
IO_PORT "scl" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sda" 72;
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "lcd_clk" 77;
IO_PORT "lcd_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_den" 48;
IO_PORT "lcd_den" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "lcd_r[4]" 38;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_r[3]" 39;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_r[2]" 40;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_r[1]" 41;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_r[0]" 42;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "lcd_g[5]" 32;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_g[4]" 33;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_g[3]" 34;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_g[2]" 35;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_g[1]" 36;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_g[0]" 37;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "lcd_b[4]" 27;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_b[3]" 28;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_b[2]" 29;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_b[1]" 30;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_b[0]" 31;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;


// Keyboard wiring
// ┌────────────┬────────┬─────────────────────────────┐
// │ Wire color │ Signal │         Connect to          │
// ├────────────┼────────┼─────────────────────────────┤
// │ Black      │ GND    │                             │
// ├────────────┼────────┼─────────────────────────────┤
// │ Red        │ VCC    │                             │
// ├────────────┼────────┼─────────────────────────────┤
// │ White      │ SCL    │            pin 71           │
// ├────────────┼────────┼─────────────────────────────┤
// │ Yellow     │ SDA    │            pin 72           │
// └────────────┴────────┴─────────────────────────────┘