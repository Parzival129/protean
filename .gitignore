# --- Docs (intentionally untracked for now) ---
docs/

# --- Local scratch / third-party test projects (never pushed) ---
sandbox/

# --- FPGA build artifacts ---
build/
# generated every build from firmware/ (baked into RAM at synth via $readmemh)
personas/shell/firmware.hex
# yosys/ABC drops this in CWD on every synth run
abc.history
# GB core boot ROM copied to CWD for synth (source of truth: personas/gameboy/roms/)
/bootrom.mif
# ROM images are not redistributable — keep game dumps out of git
personas/gameboy/roms/game.hex
personas/gameboy/roms/*.gb
*.json          # yosys netlist + nextpnr placed netlist (protean.json, *_pnr.json)
*.fs            # gowin_pack bitstream
*.fs.json       # gowin_pack sidecar metadata

# --- Verilator / simulation ---
obj_dir/
# cocotb / pyuvm build + results
verif/**/sim_build/
verif/**/results.xml
*.vcd           # waveform dumps
*.fst
*.gtkw          # gtkwave save files (drop this line to track curated views)

# --- Python (tools / scripts) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# demo videos: local only (MP4s are heavy; GIFs are tracked for the README)
media/*.mp4
